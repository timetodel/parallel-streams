{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if (Test-Path -LiteralPath \"$PWD/skills/parallel-streams/coordination/hooks/deliver-wave-board.ps1\") { \"$PWD\" } else { $env:CLAUDE_PROJECT_DIR })/skills/parallel-streams/coordination/hooks/deliver-wave-board.ps1\" -Stage Start",
            "timeout": 20,
            "statusMessage": "Checking the wave board"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if (Test-Path -LiteralPath \"$PWD/skills/parallel-streams/coordination/hooks/deliver-wave-board.ps1\") { \"$PWD\" } else { $env:CLAUDE_PROJECT_DIR })/skills/parallel-streams/coordination/hooks/deliver-wave-board.ps1\" -Stage Prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if (Test-Path -LiteralPath \"$PWD/skills/parallel-streams/coordination/hooks/nudge-wave-plan-edit.ps1\") { \"$PWD\" } else { $env:CLAUDE_PROJECT_DIR })/skills/parallel-streams/coordination/hooks/nudge-wave-plan-edit.ps1\"",
            "if": "Edit(//**/docs/plans/**)",
            "timeout": 20
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(if (Test-Path -LiteralPath \"$PWD/skills/parallel-streams/coordination/hooks/nudge-wave-plan-edit.ps1\") { \"$PWD\" } else { $env:CLAUDE_PROJECT_DIR })/skills/parallel-streams/coordination/hooks/nudge-wave-plan-edit.ps1\"",
            "if": "Write(//**/docs/plans/**)",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
